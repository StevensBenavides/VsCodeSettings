{
    
    "workbench.editor.showTabs": "single",
    "workbench.tree.indent": 16,
    "workbench.tree.enableStickyScroll": false,
    "workbench.tree.renderIndentGuides": "none",
    "workbench.tips.enabled": false,
    "workbench.colorTheme": "Gruvbox in Black",
    "workbench.layoutControl.enabled": false,
    "workbench.navigationControl.enabled": false,
    "workbench.iconTheme": "symbols",
    "workbench.editor.empty.hint": "hidden",
    "workbench.productIconTheme": "fluent-icons",
    "terminal.integrated.gpuAcceleration": "on",
    "terminal.integrated.fontFamily": "JetBrainsMonoNF Nerd Font",
    "terminal.integrated.defaultProfile.linux": "fish",
    "breadcrumbs.enabled": false,
    "search.searchOnType": false,
    "explorer.compactFolders": false,
    "explorer.decorations.badges": false,
    "window.dialogStyle": "custom",
    "window.titleBarStyle": "custom",
    "window.menuBarVisibility": "compact",
    "window.commandCenter": false,
    "window.titleSeparator": " > ",
    "window.title": "Stevens Benavides",
    "symbols.hidesExplorerArrows": true,
    "editor.snippetSuggestions": "top",
    "editor.minimap.enabled": false,
    "editor.codeLens": false,
    "editor.quickSuggestionsDelay": 0,
    "editor.fontFamily": "JetBrainsMonoNF Nerd Font",
    "editor.fontSize": 14,
    "editor.fontWeight": "bold",
    "editor.smoothScrolling": false,
    "editor.overviewRulerBorder": false,
    "editor.cursorStyle": "block",
    "editor.cursorBlinking": "solid",
    "editor.guides.indentation": false,
    "editor.inlineSuggest.suppressSuggestions": true,
    "editor.cursorSmoothCaretAnimation": "off",
    "editor.stickyScroll.enabled": false,
    "editor.autoIndentOnPaste": true,
    "editor.copyWithSyntaxHighlighting": false,
    "security.workspace.trust.untrustedFiles": "open",
    "oneDarkPro.italic": false,
    "[rust]": {
        "editor.defaultFormatter": "rust-lang.rust-analyzer",
        "editor.formatOnSave": true
    },
    "git.confirmSync": false,
    "git.autofetch": true,
    "git.enableSmartCommit": true,
    "rust-analyzer.check.command": "clippy",
    "git.openRepositoryInParentFolders": "never",
    "update.showReleaseNotes": false,
    "python.analysis.typeCheckingMode": "basic",
    "manim-sideview.defaultManimPath": "/home/linuxu/.local/bin/manim",
    "workbench.startupEditor": "none",
    "update.mode": "none",
    "animations.Install-Method": "Custom UI Style",
    "custom-ui-style.external.imports": [
        "file:///home/linuxu/.vscode/extensions/brandonkirbyson.vscode-animations-2.0.7/dist/updateHandler.js"
    ],
    "animations.CursorAnimation": true,
    "animations.CursorAnimationOptions": {
        "CursorStyle": "block",    
        "TrailLength": 8,
        "Color": "#FFFFFF",
    },
    "animations.Scrolling": "None",
    "animations.Enabled": false,
    "animations.Durations": {
        "Scrolling": 0,
        "Smooth-Mode": 0.01,
        "Tabs": 0,
        "Active": 0,
        "Focus-Dimming": 0,
        "Command-Palette": 0,
    },
    "oneDarkPro.bold": true,
    "oneDarkPro.vivid": true,
    "C_Cpp.dimInactiveRegions": false,
    "telemetry.telemetryLevel": "off",
    "files.hotExit": "onExitAndWindowClose",
    "extensions.autoUpdate": "off",
    "terminal.integrated.initialHint": false,
    "cmake.showConfigureWithDebuggerNotification": false,
    "files.watcherExclude": {
        ".git/objects": true,
        ".git/subtree-cache": true,
        "node_modules/*": true,
        "__pycache__/*": true,
        "dist": true,
        "build": true,
        ".vscode": true,
        "coverage": true,
        "__generated__": true,
        "tmp": true,
        ".cache": true,
        "target": true,
        ".target": true,
    },
    "search.exclude": {
        ".git/objects": true,
        ".git/subtree-cache": true,
        "node_modules/*": true,
        "__pycache__/*": true,
        "dist": true,
        "build": true,
        ".vscode": true,
        "coverage": true,
        "__generated__": true,
        "tmp": true,
        ".cache": true,
        "target": true,
        ".target": true,
    },
    "animations.UseCursorColorForCursorAnimation": true,
    "json.schemaDownload.trustedDomains": {
        "https://developer.microsoft.com/json-schemas/": true,
        "https://json-schema.org/": true,
        "https://json.schemastore.org/": true,
        "https://raw.githubusercontent.com": true,
        "https://raw.githubusercontent.com/devcontainers/spec/": true,
        "https://raw.githubusercontent.com/microsoft/vscode/": true,
        "https://schemastore.azurewebsites.net/": true,
        "https://www.schemastore.org/": true
    },
}